@model FBZSystemMvc.Models.ComicDetailsViewModel

@{
    ViewData["Title"] = "Comic Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Comic.MainTitle</h1>

    <a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Comic.MainTitle</dd>

            <dt class="col-sm-3">Authors</dt>
            <dd class="col-sm-9">
                @(Model.AuthorsDisplay.Count == 0 ? "—" : string.Join(", ", Model.AuthorsDisplay))
            </dd>

            <dt class="col-sm-3">Publication years</dt>
            <dd class="col-sm-9">
                @(Model.YearsDisplay.Count == 0 ? "—" : string.Join(", ", Model.YearsDisplay))
            </dd>

            <dt class="col-sm-3">Genres</dt>
            <dd class="col-sm-9">
                @(Model.GenresDisplay.Count == 0 ? "—" : string.Join(", ", Model.GenresDisplay))
            </dd>

            <dt class="col-sm-3">ISBNs</dt>
            <dd class="col-sm-9">
                @(Model.IsbnsDisplay.Count == 0 ? "missing" : string.Join(", ", Model.IsbnsDisplay))
            </dd>
        </dl>
    </div>
</div>

@if (User != null && User.IsInRole("Staff"))
{
    if (!Model.IsFlagged)
    {
        <form asp-controller="Flags" asp-action="Flag" method="post" class="m-0 d-flex gap-2 align-items-center">
            <input type="hidden" name="comicId" value="@Model.Comic.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <input type="text" name="reason" class="form-control form-control-sm" style="width: 220px;" placeholder="Reason (optional)" />
            <button type="submit" class="btn btn-warning">Flag</button>
        </form>
    }
    else
    {
        <form asp-controller="Flags" asp-action="Unflag" method="post" class="m-0">
            <input type="hidden" name="comicId" value="@Model.Comic.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button type="submit" class="btn btn-outline-warning">Unflag</button>
        </form>
    }
}

@if (Model.InfoLines is not null && Model.InfoLines.Count > 0)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Metadata</h5>
            <ul class="mb-0">
                @foreach (var line in Model.InfoLines)
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.GoogleBooks?.HasData == true)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">External Book Info (Google Books)</h5>

            <dl class="row mb-0">
                @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.Title))
                {
                    <dt class="col-sm-3">Matched title</dt>
                    <dd class="col-sm-9">@Model.GoogleBooks.Title</dd>
                }
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.OpenLibraryCoverUrl))
            {
                <div class="card mb-3" style="max-width: 220px;">
                    <div class="card-body text-center">
                        <h5 class="card-title">Cover</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.OpenLibraryCoverUrl))
                        {
                            <img src="@Model.OpenLibraryCoverUrl"
                                alt="Comic cover for @Model.Comic.MainTitle"
                                class="img-fluid rounded shadow-sm"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <p class="text-muted mt-2 mb-0" style="display:none;">Cover not available</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.OpenLibrary?.CoverUrl))
                        {
                            <img src="@Model.OpenLibrary.CoverUrl"
                                alt="Comic cover for @Model.Comic.MainTitle"
                                class="img-fluid rounded shadow-sm"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <p class="text-muted mt-2 mb-0" style="display:none;">Cover not available</p>
                        }
                        else
                        {
                            <p class="text-muted mt-2 mb-0">Cover not available</p>
                        }
                    </div>
                </div>
            }

            <dl class="row mb-0">
                @if (Model.GoogleBooks.Authors?.Count > 0)
                {
                    <dt class="col-sm-3">Matched authors</dt>
                    <dd class="col-sm-9">@string.Join(", ", Model.GoogleBooks.Authors)</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.Publisher))
                {
                    <dt class="col-sm-3">Publisher</dt>
                    <dd class="col-sm-9">@Model.GoogleBooks.Publisher</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.PublishedDate))
                {
                    <dt class="col-sm-3">Published date</dt>
                    <dd class="col-sm-9">@Model.GoogleBooks.PublishedDate</dd>
                }

                @if (Model.GoogleBooks.PageCount.HasValue)
                {
                    <dt class="col-sm-3">Page count</dt>
                    <dd class="col-sm-9">@Model.GoogleBooks.PageCount</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.Description))
                {
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.GoogleBooks.Description</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.PreviewLink) ||
                     !string.IsNullOrWhiteSpace(Model.GoogleBooks.InfoLink))
                {
                    <dt class="col-sm-3">Links</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.PreviewLink))
                        {
                            <a href="@Model.GoogleBooks.PreviewLink" target="_blank" rel="noopener noreferrer" class="me-3">Preview</a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.GoogleBooks.InfoLink))
                        {
                            <a href="@Model.GoogleBooks.InfoLink" target="_blank" rel="noopener noreferrer">More info</a>
                        }
                    </dd>
                }
            </dl>
        </div>
    </div>
}

@{
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={Uri.EscapeDataString(pageUrl)}";
}

<div class="card mt-3" style="max-width: 220px;">
    <div class="card-body text-center">
        <h5 class="card-title">QR Code</h5>
        <img src="@qrUrl" alt="QR code linking to this page" class="img-fluid" />
        <p class="text-muted mt-2 mb-0" style="font-size: 0.75rem;">Scan to open this page</p>
    </div>
</div>

@if (Model.OpenLibrary?.HasData == true)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Additional Library Data (Open Library)</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.OpenLibrary.Title))
                {
                    <dt class="col-sm-3">Matched title</dt>
                    <dd class="col-sm-9">@Model.OpenLibrary.Title</dd>
                }

                @if (Model.OpenLibrary.FirstPublishYear.HasValue)
                {
                    <dt class="col-sm-3">First publish year</dt>
                    <dd class="col-sm-9">@Model.OpenLibrary.FirstPublishYear</dd>
                }

                @if (Model.OpenLibrary.AuthorNames?.Count > 0)
                {
                    <dt class="col-sm-3">Authors</dt>
                    <dd class="col-sm-9">@string.Join(", ", Model.OpenLibrary.AuthorNames)</dd>
                }

                @if (Model.OpenLibrary.Subjects?.Count > 0)
                {
                    <dt class="col-sm-3">Subjects</dt>
                    <dd class="col-sm-9">@string.Join(", ", Model.OpenLibrary.Subjects)</dd>
                }

                @if (Model.OpenLibrary.Isbns?.Count > 0)
                {
                    <dt class="col-sm-3">Related ISBNs</dt>
                    <dd class="col-sm-9">@string.Join(", ", Model.OpenLibrary.Isbns)</dd>
                }

            </dl>
        </div>
    </div>
}