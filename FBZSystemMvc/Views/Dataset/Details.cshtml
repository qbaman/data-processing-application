@model FBZSystemMvc.Models.ComicDetailsViewModel

@{
    ViewData["Title"] = Model.Comic.MainTitle ?? "Comic Details";

    var coverUrl = Model.OpenLibraryCoverUrl
        ?? Model.OpenLibrary?.CoverUrl;

    var description = Model.GoogleBooks?.Description
        ?? (!string.IsNullOrWhiteSpace(Model.Wikipedia?.Extract) ? Model.Wikipedia!.Extract : null);

    var googleBooksUrl = Model.GoogleBooks?.InfoLink ?? Model.GoogleBooks?.PreviewLink;
    var wikipediaUrl   = Model.Wikipedia?.PageUrl;

    var qrTarget = wikipediaUrl ?? googleBooksUrl;
    var qrUrl    = string.IsNullOrWhiteSpace(qrTarget)
        ? null
        : $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={Uri.EscapeDataString(qrTarget)}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Dataset" asp-action="Index">Search</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Comic.MainTitle</li>
        </ol>
    </nav>
    <a class="btn btn-outline-secondary btn-sm" href="javascript:history.back()">&#8592; Back</a>
</div>


<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-auto">
                @if (!string.IsNullOrWhiteSpace(coverUrl))
                {
                    <img src="@coverUrl"
                         alt="Cover for @Model.Comic.MainTitle"
                         class="rounded shadow-sm"
                         style="width:140px; object-fit:cover;"
                         onerror="this.style.display='none'; document.getElementById('cover-placeholder').style.display='flex';" />
                    <div id="cover-placeholder"
                         class="rounded bg-secondary d-none align-items-center justify-content-center text-white"
                         style="width:140px; height:200px; font-size:.75rem;">No cover</div>
                }
                else
                {
                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center text-white"
                         style="width:140px; height:200px; font-size:.75rem;">No cover</div>
                }
            </div>

            <div class="col">
                <h1 class="h2 mb-2">@Model.Comic.MainTitle</h1>

                @if (Model.AuthorsDisplay.Count > 0)
                {
                    <p class="mb-1">
                        <span class="fw-semibold">Author@(Model.AuthorsDisplay.Count > 1 ? "s" : ""):</span>
                        @string.Join(", ", Model.AuthorsDisplay)
                    </p>
                }

                @if (Model.YearsDisplay.Count > 0)
                {
                    <p class="mb-1">
                        <span class="fw-semibold">Year@(Model.YearsDisplay.Count > 1 ? "s" : ""):</span>
                        @string.Join(", ", Model.YearsDisplay)
                    </p>
                }

                @if (Model.GenresDisplay.Count > 0)
                {
                    <p class="mb-2">
                        <span class="fw-semibold">Genre@(Model.GenresDisplay.Count > 1 ? "s" : ""):</span>
                        @string.Join(", ", Model.GenresDisplay)
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(googleBooksUrl) || !string.IsNullOrWhiteSpace(wikipediaUrl) || !string.IsNullOrWhiteSpace(qrUrl))
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (!string.IsNullOrWhiteSpace(googleBooksUrl))
                        {
                            <a href="@googleBooksUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                View on Google Books
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(wikipediaUrl))
                        {
                            <a href="@wikipediaUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                                Read on Wikipedia
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(qrUrl))
                        {
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#qr-panel"
                                    aria-expanded="false">
                                QR Code
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(qrUrl))
                    {
                        <div class="collapse mt-2" id="qr-panel">
                            <img src="@qrUrl"
                                 alt="QR code for @Model.Comic.MainTitle"
                                 class="rounded border"
                                 style="width:120px;" />
                            <p class="text-muted mt-1 mb-0" style="font-size:.7rem;">
                                Links to @(!string.IsNullOrWhiteSpace(wikipediaUrl) ? "Wikipedia" : "Google Books")
                            </p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>


@if (!string.IsNullOrWhiteSpace(description))
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Summary</h5>
            <p class="mb-0 lh-lg">@description</p>
        </div>
    </div>
}


<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Details</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Comic.MainTitle</dd>

            <dt class="col-sm-3">Author@(Model.AuthorsDisplay.Count > 1 ? "s" : "")</dt>
            <dd class="col-sm-9">@(Model.AuthorsDisplay.Count == 0 ? "—" : string.Join(", ", Model.AuthorsDisplay))</dd>

            <dt class="col-sm-3">Year@(Model.YearsDisplay.Count > 1 ? "s" : "")</dt>
            <dd class="col-sm-9">@(Model.YearsDisplay.Count == 0 ? "—" : string.Join(", ", Model.YearsDisplay))</dd>

            <dt class="col-sm-3">Genre@(Model.GenresDisplay.Count > 1 ? "s" : "")</dt>
            <dd class="col-sm-9">@(Model.GenresDisplay.Count == 0 ? "—" : string.Join(", ", Model.GenresDisplay))</dd>

            <dt class="col-sm-3">ISBN@(Model.IsbnsDisplay.Count > 1 ? "s" : "")</dt>
            <dd class="col-sm-9">@(Model.IsbnsDisplay.Count == 0 ? "—" : string.Join(", ", Model.IsbnsDisplay))</dd>

            @if (Model.GoogleBooks?.Publisher is not null)
            {
                <dt class="col-sm-3">Publisher</dt>
                <dd class="col-sm-9">@Model.GoogleBooks.Publisher</dd>
            }

            @if (Model.GoogleBooks?.PageCount.HasValue == true)
            {
                <dt class="col-sm-3">Page count</dt>
                <dd class="col-sm-9">@Model.GoogleBooks.PageCount</dd>
            }

            @if (Model.OpenLibrary?.Subjects?.Count > 0)
            {
                <dt class="col-sm-3">Subjects</dt>
                <dd class="col-sm-9">@string.Join(", ", Model.OpenLibrary.Subjects.Take(8))</dd>
            }

            @foreach (var line in Model.InfoLines ?? new())
            {
                var sep = line.IndexOf(':');
                if (sep > 0)
                {
                    <dt class="col-sm-3">@line[..sep]</dt>
                    <dd class="col-sm-9">@line[(sep + 1)..].Trim()</dd>
                }
                else
                {
                    <dt class="col-sm-3 col-sm-9">@line</dt>
                    <dd class="col-sm-9"></dd>
                }
            }
        </dl>
    </div>
</div>


@if (Model.Wikipedia?.HasData == true)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">About the Author</h5>
            <div class="d-flex gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.Wikipedia.ThumbnailUrl))
                {
                    <img src="@Model.Wikipedia.ThumbnailUrl"
                         alt="Photo of @Model.Wikipedia.Title"
                         class="rounded flex-shrink-0"
                         style="width:80px; height:80px; object-fit:cover;" />
                }
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.Wikipedia.Title))
                    {
                        <h6 class="mb-1">@Model.Wikipedia.Title</h6>
                    }
                    <p class="mb-1 lh-lg">@Model.Wikipedia.Extract</p>
                    @if (!string.IsNullOrWhiteSpace(wikipediaUrl))
                    {
                        <a href="@wikipediaUrl" target="_blank" rel="noopener noreferrer" class="small">Read more on Wikipedia &#8599;</a>
                    }
                </div>
            </div>
        </div>
    </div>
}


@if (User != null && User.IsInRole("Staff"))
{
    <div class="mb-4">
        @if (!Model.IsFlagged)
        {
            <form asp-controller="Flags" asp-action="Flag" method="post" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="comicId" value="@Model.Comic.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <input type="text" name="reason" class="form-control form-control-sm" style="width:220px;" placeholder="Flag reason (optional)" />
                <button type="submit" class="btn btn-sm btn-warning">Flag</button>
            </form>
        }
        else
        {
            <form asp-controller="Flags" asp-action="Unflag" method="post" class="d-inline">
                <input type="hidden" name="comicId" value="@Model.Comic.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="btn btn-sm btn-outline-warning">Unflag</button>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.FlagReason))
            {
                <span class="ms-2 text-warning small">Flagged: @Model.FlagReason</span>
            }
        }
    </div>
}


@if (Model.RelatedComics.Count > 0)
{
    <div class="mb-4">
        <h5 class="mb-3">Related Comics</h5>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var rel in Model.RelatedComics)
            {
                <div class="col">
                    <a asp-action="Details" asp-route-id="@rel.Id"
                       class="card h-100 text-decoration-none hover-card">
                        <div class="card-body p-3">
                            <p class="fw-semibold mb-1 small lh-sm">@rel.MainTitle</p>
                            @if (rel.Authors?.Count > 0)
                            {
                                <p class="mb-1 opacity-75" style="font-size:.75rem;">@rel.Authors.First()</p>
                            }
                            @if (rel.Years?.Count > 0)
                            {
                                <span class="badge text-bg-secondary" style="font-size:.7rem;">@rel.Years.Min()</span>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}


@if (Model.RecentlyViewedComics.Count > 0)
{
    <div class="mb-4">
        <h5 class="mb-3">Recently Viewed</h5>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var rv in Model.RecentlyViewedComics)
            {
                <a asp-action="Details" asp-route-id="@rv.Id"
                   class="card text-decoration-none hover-card"
                   style="min-width:140px; max-width:180px;">
                    <div class="card-body p-3">
                        <p class="fw-semibold mb-1 small lh-sm">@rv.MainTitle</p>
                        @if (rv.Years?.Count > 0)
                        {
                            <p class="mb-0 opacity-75" style="font-size:.75rem;">@rv.Years.Min()</p>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
}

<style>
.hover-card { transition: box-shadow .15s, transform .15s; }
.hover-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.15); transform: translateY(-2px); }
</style>
