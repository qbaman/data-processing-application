@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold">Fantasy B’zaar Encyclopedia System</h1>
        <p class="col-md-10 fs-5 mb-3">
            A web-based comic-book encyclopedia built for Fantasy B’zaar (FBZ) to help customers and staff search,
            explore and manage historical comic records from the British Library “Comics Unmasked” dataset.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-lg" href="/Dataset">Open Dataset Search</a>
            <a class="btn btn-outline-secondary btn-lg" href="/Dataset?kiosk=1">Open Kiosk Mode</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">What you can do</h5>
                <ul class="mb-0">
                    <li>Basic and advanced search (title, author, year range, genre, language, resource type, and more)</li>
                    <li>Sort results A–Z / Z–A and group by Author or Year</li>
                    <li>View detailed comic records with formatted metadata</li>
                    <li>Build a session “Search List”, export it to CSV, and save lists to your account</li>
                    <li>Staff-only features: flag records for review and view analytics dashboards</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">System overview</h5>
                <ul class="mb-0">
                    <li>Dataset source: British Library “Comics Unmasked” (names.csv)</li>
                    <li>Web application: ASP.NET Core MVC + Identity authentication</li>
                    <li>Persistence: SQLite (accounts, saved lists, flags, analytics)</li>
                    <li>Optimised for desktop and kiosk use</li>
                    <li>Designed to support multiple concurrent users</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="card-title mb-1">Created by</h5>
                    <p class="mb-0">aman</p>
                </div>
                <div class="text-muted">
                    Fantasy B’zaar Encyclopedia System • Phase 1 (names.csv)
                </div>
            </div>
        </div>
    </div>
</div>