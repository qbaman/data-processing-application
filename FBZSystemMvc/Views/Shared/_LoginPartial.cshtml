@using Microsoft.AspNetCore.Mvc.TagHelpers

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated ?? false)
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="SavedComics" asp-action="Index">Saved</a>
    </li>

    <li class="nav-item">
        <span class="nav-link text-dark">Hello @User.Identity!.Name!</span>
    </li>

    <li class="nav-item">
        <form method="post" action="/account/logout" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link text-dark p-0">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
    <a class="nav-link text-dark" href="/account/logout?returnUrl=/">Logout</a>
</li>
}
</ul>