<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FBZSystemMvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FBZSystemMvc.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FBZSystemMvc</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Dataset" asp-action="Index">Dataset</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/saved-lists">Saved Lists</a>
                        </li>

                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/flags">Flagged Records</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/dataset">Dataset Updates</a>
                            </li>
                        }
                    </ul>

                        <button id="theme-toggle"
                                class="btn btn-outline-secondary theme-toggle-btn"
                                type="button"
                                aria-label="Toggle dark mode"
                                title="Toggle dark mode">
                            <i id="theme-icon" class="bi bi-moon-stars-fill"></i>
                        </button>

                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-4">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <p class="mb-1 fw-semibold">Stay Updated</p>
                    <p class="mb-2 small">Get notified when new comics are added or features change.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <input type="email"
                               id="newsletter-input"
                               class="form-control form-control-sm"
                               style="max-width:220px;"
                               placeholder="your@email.com"
                               autocomplete="email"
                               aria-label="Newsletter email address" />
                        <button type="button"
                                id="newsletter-btn"
                                class="btn btn-sm btn-primary">
                            Subscribe
                        </button>
                    </div>
                    <div id="newsletter-status" class="mt-2 small" style="display:none;" role="status" aria-live="polite"></div>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 - FBZSystemMvc</p>
                    <p class="mb-0 small">
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script>
    (function () {
        var btn    = document.getElementById('newsletter-btn');
        var input  = document.getElementById('newsletter-input');
        var status = document.getElementById('newsletter-status');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var email = (input.value || '').trim();
            if (!email) {
                status.textContent = 'Please enter your email address.';
                status.className = 'mt-2 small text-danger';
                status.style.display = 'block';
                return;
            }
            btn.disabled = true;
            btn.textContent = 'Subscribing\u2026';
            setTimeout(function () {
                status.textContent = 'Subscribed! You\u2019ll be notified of updates.';
                status.className = 'mt-2 small text-success';
                status.style.display = 'block';
                btn.textContent = 'Subscribed';
            }, 600);
        });
    }());
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>